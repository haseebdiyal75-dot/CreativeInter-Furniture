<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CreativeInter Furnitures | Manufacturer · Wholesaler · Importer – Islamabad</title>
<meta name="description" content="Premium furniture manufacturer and wholesaler in Islamabad. Home & office furniture, beds, sofas, dining tables and more. Visit Soan Gardens showroom.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400;1,600&family=DM+Sans:opsz,wght@9..40,200;9..40,300;9..40,400;9..40,500&family=Playfair+Display:ital,wght@1,400;1,700&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --ink:#08060A;
  --ink2:#100D14;
  --deep:#1A1020;
  --wood-deep:#2E1A08;
  --wood-mid:#6A3818;
  --wood-warm:#A05020;
  --gold:#C89840;
  --gold-hi:#E8B85A;
  --gold-lo:rgba(200,152,64,.15);
  --gold-med:rgba(200,152,64,.35);
  --cream:#F4EAD5;
  --cream2:#DEC99A;
  --muted:#7A6050;
  --white:#FDFAF3;
  --accent:#8B4513;
}
html{scroll-behavior:smooth;font-size:16px}
body{background:var(--ink);color:var(--cream);font-family:'DM Sans',sans-serif;font-weight:300;overflow-x:hidden}



/* ── Noise overlay ── */
body::after{content:'';position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.04;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  background-size:256px}

/* ── Notice bar ── */
#notice{
  position:relative;z-index:300;
  background:linear-gradient(90deg,var(--wood-deep),var(--wood-mid),var(--wood-deep));
  color:var(--cream2);
  text-align:center;padding:.55rem 1rem;
  font-size:.64rem;letter-spacing:.22em;text-transform:uppercase;font-weight:400;
  border-bottom:1px solid rgba(200,152,64,.2);
}
#notice a{color:var(--gold);text-decoration:none;border-bottom:1px solid rgba(200,152,64,.4)}

/* ── NAV ── */
nav{
  position:fixed;top:0;left:0;width:100%;z-index:200;
  display:flex;justify-content:space-between;align-items:center;
  padding:1.2rem 5%;
  transition:background .5s,padding .4s,box-shadow .4s,top .4s;
}
nav.scrolled{
  background:rgba(8,6,10,.97);padding:.8rem 5%;
  box-shadow:0 1px 0 rgba(200,152,64,.15);
  backdrop-filter:blur(14px);
}
.logo-mono{display:flex;align-items:center;gap:.75rem;text-decoration:none;flex-shrink:0}
.fpl-mark{
  width:42px;height:42px;border:1px solid rgba(200,152,64,.5);
  border-radius:2px;display:flex;align-items:center;justify-content:center;
  position:relative;overflow:hidden;flex-shrink:0;
  background:linear-gradient(135deg,rgba(200,152,64,.08),transparent);
}
.fpl-mark::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 45%,rgba(200,152,64,.07) 45%)}
.fpl-letters{font-family:'Cormorant Garamond',serif;font-size:1.1rem;font-weight:600;color:var(--gold);letter-spacing:.02em;line-height:1;position:relative;z-index:1}
.fpl-glow{position:absolute;width:20px;height:20px;background:radial-gradient(circle,rgba(200,152,64,.35),transparent 70%);top:50%;left:50%;transform:translate(-50%,-50%);animation:pulse-glow 2.5s ease-in-out infinite}
@keyframes pulse-glow{0%,100%{opacity:.4;transform:translate(-50%,-50%) scale(.8)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.4)}}
.logo-text{font-family:'Cormorant Garamond',serif;font-size:1.3rem;font-weight:600;letter-spacing:.04em;color:var(--cream);line-height:1}
.logo-text span{color:var(--gold)}
.logo-sub{font-size:.52rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-top:.1rem}
.nav-center{display:flex;gap:2.2rem;list-style:none}
.nav-center a{font-size:.63rem;letter-spacing:.24em;text-transform:uppercase;color:rgba(212,195,155,.7);text-decoration:none;transition:color .3s;position:relative;font-weight:400}
.nav-center a::after{content:'';position:absolute;bottom:-4px;left:0;width:0;height:1px;background:var(--gold);transition:width .35s}
.nav-center a:hover{color:var(--gold)}
.nav-center a:hover::after{width:100%}
.nav-right{display:flex;gap:.7rem;align-items:center}
.btn-sm{display:inline-flex;align-items:center;gap:.45rem;padding:.5rem 1.2rem;border-radius:1px;font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;font-weight:500;text-decoration:none;transition:all .28s;border:none;font-family:'DM Sans',sans-serif}
.btn-wa{background:#128C7E;color:#fff}
.btn-wa:hover{background:#075E54;transform:translateY(-1px);box-shadow:0 4px 18px rgba(18,140,126,.3)}
.btn-gold{background:var(--gold);color:var(--ink)}
.btn-gold:hover{background:var(--gold-hi);transform:translateY(-1px);box-shadow:0 4px 18px rgba(200,152,64,.3)}
.btn-outline{border:1px solid rgba(200,152,64,.4);color:var(--gold);background:transparent}
.btn-outline:hover{background:var(--gold-lo);border-color:var(--gold)}
.btn-lg{padding:.85rem 2.2rem;font-size:.7rem}
.ham{display:none;flex-direction:column;gap:5px;background:none;border:none;padding:4px}
.ham span{display:block;width:22px;height:1.5px;background:var(--cream);transition:.3s}
.ham.open span:nth-child(1){transform:rotate(45deg) translate(4.5px,4.5px)}
.ham.open span:nth-child(2){opacity:0}
.ham.open span:nth-child(3){transform:rotate(-45deg) translate(4.5px,-4.5px)}

/* Mobile menu */
#mob{display:none;position:fixed;inset:0;z-index:190;background:rgba(8,6,10,.99);flex-direction:column;align-items:center;justify-content:center;gap:2rem}
#mob.open{display:flex}
#mob a{font-family:'Cormorant Garamond',serif;font-size:2.1rem;color:var(--cream);text-decoration:none;letter-spacing:.04em;transition:color .3s}
#mob a:hover{color:var(--gold)}
#mob hr{width:36px;border:none;border-top:1px solid rgba(200,152,64,.2)}

/* ── HERO ── */
#hero{
  min-height:100vh;position:relative;overflow:hidden;
  display:grid;grid-template-columns:1fr 1fr;align-items:center;
  padding:140px 5% 100px;gap:5rem;
}
.hero-bg{
  position:absolute;inset:0;z-index:0;
  background-image:url('https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=800&q=80&auto=format&fit=crop');
  background-size:cover;background-position:center;
  filter:brightness(.18) saturate(.7);
}
.hero-diag{
  position:absolute;inset:0;z-index:1;pointer-events:none;
  background:repeating-linear-gradient(-55deg,transparent,transparent 38px,rgba(200,152,64,.022) 38px,rgba(200,152,64,.022) 39px);
  animation:diag-drift 30s linear infinite;
}
@keyframes diag-drift{from{background-position:0 0}to{background-position:200px 200px}}
.hero-glow{
  position:absolute;top:40%;left:30%;transform:translate(-50%,-50%);
  width:700px;height:700px;border-radius:50%;pointer-events:none;z-index:0;
  background:radial-gradient(circle,rgba(200,152,64,.09) 0%,transparent 65%);
  animation:glow-pulse 4s ease-in-out infinite;
}
@keyframes glow-pulse{0%,100%{transform:translate(-50%,-50%) scale(1);opacity:.7}50%{transform:translate(-50%,-50%) scale(1.18);opacity:1}}
.hero-text{position:relative;z-index:2}
.fi-1{opacity:0;animation:fade-up .8s .1s forwards}
.fi-2{opacity:0;animation:fade-up .8s .28s forwards}
.fi-3{opacity:0;animation:fade-up .8s .46s forwards}
.fi-4{opacity:0;animation:fade-up .8s .64s forwards}
.fi-5{opacity:0;animation:fade-up .8s .82s forwards}
.fi-6{opacity:0;animation:fade-up .8s 1s forwards}
@keyframes fade-up{from{opacity:0;transform:translateY(32px)}to{opacity:1;transform:none}}
.hero-badge{
  display:inline-flex;align-items:center;gap:.6rem;
  border:1px solid rgba(200,152,64,.28);color:var(--gold);
  font-size:.58rem;letter-spacing:.3em;text-transform:uppercase;
  padding:.38rem 1.1rem;border-radius:1px;margin-bottom:2rem;
}
.hero-badge::before{content:'';display:block;width:20px;height:1px;background:var(--gold)}
h1.hero-h{font-family:'Cormorant Garamond',serif;font-size:clamp(3.2rem,5.5vw,6.2rem);font-weight:300;line-height:1.0;letter-spacing:-.02em}
h1.hero-h em{font-style:italic;color:var(--gold)}
h1.hero-h strong{font-weight:600;display:block}
.hero-p{font-size:.88rem;color:rgba(212,195,155,.8);line-height:1.9;max-width:420px;margin:1.8rem 0 2.4rem}
.hero-ctas{display:flex;gap:1rem;flex-wrap:wrap}
.hero-stats{display:flex;gap:3rem;margin-top:3.5rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.05);flex-wrap:wrap}
.stat .n{font-family:'Cormorant Garamond',serif;font-size:2.4rem;color:var(--cream);line-height:1}
.stat .n em{color:var(--gold);font-size:1.4rem;font-style:normal}
.stat .l{font-size:.6rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:.25rem}

/* Hero image panel */
.hero-img-panel{
  position:relative;z-index:2;height:520px;
  border-radius:2px;overflow:hidden;
  border:1px solid rgba(200,152,64,.18);
  box-shadow:0 30px 80px rgba(0,0,0,.5);
}
.hero-img-panel img{width:100%;height:100%;object-fit:cover;filter:sepia(.1) contrast(1.05)}
.hero-img-overlay{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(8,6,10,.55) 0%,transparent 60%);
}
.hero-img-tag{
  position:absolute;bottom:1.5rem;left:1.5rem;
  background:rgba(8,6,10,.82);backdrop-filter:blur(10px);
  border:1px solid rgba(200,152,64,.22);
  padding:.7rem 1.1rem;border-radius:2px;
  font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;color:var(--gold);
}
.hero-img-corner{
  position:absolute;top:1rem;right:1rem;
  background:var(--gold);color:var(--ink);
  font-family:'Cormorant Garamond',serif;font-size:1.5rem;font-weight:600;
  padding:.5rem .9rem;border-radius:1px;line-height:1.1;text-align:center;
}
.hero-img-corner span{display:block;font-family:'DM Sans',sans-serif;font-size:.5rem;letter-spacing:.15em;text-transform:uppercase;font-weight:500}

.scroll-hint{position:absolute;bottom:2.5rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:.5rem;color:var(--muted);font-size:.58rem;letter-spacing:.22em;text-transform:uppercase;animation:bob 2.5s ease-in-out infinite;z-index:2}
.scroll-hint::after{content:'';display:block;width:1px;height:38px;background:linear-gradient(to bottom,var(--gold),transparent)}
@keyframes bob{0%,100%{transform:translateX(-50%) translateY(0)}50%{transform:translateX(-50%) translateY(7px)}}

/* ── TICKER ── */
.ticker-wrap{position:relative;z-index:10;overflow:hidden;background:var(--gold);padding:.7rem 0;border-top:1px solid rgba(255,255,255,.1);border-bottom:1px solid rgba(0,0,0,.2)}
.ticker-inner{display:flex;white-space:nowrap;animation:ticker 38s linear infinite}
.ticker-inner:hover{animation-play-state:paused}
.ticker-item{display:inline-flex;align-items:center;gap:.8rem;padding:0 2.5rem;font-size:.65rem;letter-spacing:.22em;text-transform:uppercase;font-weight:500;color:var(--ink)}
.ticker-item .dot{width:4px;height:4px;background:rgba(14,10,5,.4);border-radius:50%;flex-shrink:0}
@keyframes ticker{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── Divider ── */
.wd{height:1px;background:linear-gradient(90deg,transparent 0%,var(--gold) 25%,var(--wood-warm) 50%,var(--gold) 75%,transparent 100%);opacity:.2;margin:0}

/* ── Section base ── */
section{padding:100px 5%}
.s-label{display:block;font-size:.58rem;letter-spacing:.32em;text-transform:uppercase;color:var(--gold);margin-bottom:.9rem}
.s-title{font-family:'Cormorant Garamond',serif;font-size:clamp(2rem,3.5vw,3.4rem);font-weight:300;line-height:1.1}
.s-title em{font-style:italic;color:var(--gold)}
.s-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:4rem;gap:1.5rem;flex-wrap:wrap}

/* ── BRAND STORY ── */
#story{background:linear-gradient(150deg,var(--ink2) 0%,var(--deep) 100%);display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center;position:relative;overflow:hidden}
#story::before{content:'';position:absolute;left:-5%;top:-10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(200,152,64,.05),transparent 65%);pointer-events:none}
.story-img-wrap{position:relative}
.story-img{height:560px;border-radius:2px;overflow:hidden;position:relative;border:1px solid rgba(200,152,64,.12);background:linear-gradient(135deg,#2E1A08,#1A0D05)}
.story-img img{width:100%;height:100%;object-fit:cover;filter:sepia(.12) contrast(1.04);opacity:0;transition:opacity .5s}
.story-img img.loaded{opacity:1}
.story-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(8,6,10,.7) 0%,transparent 50%)}
.story-float{position:absolute;bottom:1.8rem;left:1.8rem;background:var(--gold);color:var(--ink);padding:.9rem 1.4rem;border-radius:2px}
.story-float .fn{font-family:'Cormorant Garamond',serif;font-size:2.2rem;font-weight:600;line-height:1}
.story-float .fl{font-size:.56rem;letter-spacing:.17em;text-transform:uppercase;margin-top:.18rem}
.story-img-wrap::after{content:'';position:absolute;top:1.5rem;left:-1.5rem;bottom:1.5rem;width:1px;background:linear-gradient(to bottom,transparent,var(--gold),transparent);opacity:.35}
.story-copy p{font-size:.86rem;color:rgba(220,200,160,.8);line-height:1.95;margin-bottom:1.1rem}
.feat-list{list-style:none;margin-top:2rem;display:flex;flex-direction:column;gap:.8rem}
.feat-list li{display:flex;align-items:center;gap:1rem;font-size:.78rem;color:rgba(220,200,160,.85);padding:.5rem 0;border-bottom:1px solid rgba(255,255,255,.04)}
.feat-list li::before{content:'';display:block;width:22px;height:1px;background:var(--gold);flex-shrink:0;box-shadow:0 0 6px rgba(200,152,64,.5)}

/* ── PHILOSOPHY ── */
#philosophy{background:var(--wood-deep);text-align:center;padding:80px 5%;position:relative;overflow:hidden}
#philosophy::before{content:'"';position:absolute;top:-20px;left:50%;transform:translateX(-50%);font-family:'Cormorant Garamond',serif;font-size:18rem;color:rgba(200,152,64,.04);line-height:1;pointer-events:none}
.phil-quote{font-family:'Playfair Display',serif;font-style:italic;font-size:clamp(1.4rem,2.8vw,2.4rem);line-height:1.5;color:var(--cream2);max-width:820px;margin:0 auto 1.5rem}
.phil-attr{font-size:.68rem;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);display:flex;align-items:center;justify-content:center;gap:1rem}
.phil-attr::before,.phil-attr::after{content:'';display:block;width:30px;height:1px;background:var(--gold);opacity:.5}

/* ── STATS BAR ── */
#stats{background:linear-gradient(90deg,var(--ink) 0%,var(--deep) 50%,var(--ink) 100%);padding:60px 5%;border-top:1px solid rgba(200,152,64,.1);border-bottom:1px solid rgba(200,152,64,.1)}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem}
.stat-block{text-align:center;padding:2rem;border-right:1px solid rgba(200,152,64,.1);position:relative}
.stat-block:last-child{border-right:none}
.stat-block::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:40px;height:1px;background:var(--gold);opacity:.4}
.stat-big{font-family:'Cormorant Garamond',serif;font-size:3.5rem;font-weight:300;color:var(--cream);line-height:1;display:block}
.stat-big em{color:var(--gold);font-style:normal;font-size:2rem}
.stat-label{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-top:.5rem;display:block}
.stat-sub{font-size:.74rem;color:rgba(220,200,160,.5);margin-top:.25rem;display:block}

/* ── COLLECTION ── */
#cats{background:linear-gradient(165deg,var(--ink) 0%,var(--ink2) 100%)}
.cat-tabs{display:flex;gap:.5rem;flex-wrap:wrap;margin-bottom:3rem}
.cat-tab{padding:.5rem 1.25rem;border:1px solid rgba(200,152,64,.2);color:var(--muted);font-size:.63rem;letter-spacing:.18em;text-transform:uppercase;background:none;border-radius:1px;transition:all .3s;cursor:pointer;font-family:'DM Sans',sans-serif}
.cat-tab.active,.cat-tab:hover{background:var(--gold);color:var(--ink);border-color:var(--gold);box-shadow:0 4px 16px rgba(200,152,64,.25)}
.products-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1.5px}
.p-card{position:relative;overflow:hidden;background:linear-gradient(145deg,rgba(30,15,5,.35),rgba(8,6,10,.9));border:1px solid rgba(200,152,64,.08);transition:border-color .4s,transform .35s,box-shadow .35s}
.p-card:hover{border-color:rgba(200,152,64,.28);transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,.4)}
.p-img{height:240px;overflow:hidden;position:relative;background:linear-gradient(135deg,#2E1A08 0%,#1A0D05 100%)}
.p-img img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease,opacity .4s ease;display:block;opacity:0}
.p-img img.loaded{opacity:1}
.p-card:hover .p-img img{transform:scale(1.06)}
.p-shine{position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.06),transparent 50%);pointer-events:none;z-index:2}
.p-img-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(8,6,10,.65) 0%,transparent 55%);z-index:1}
.p-badge{position:absolute;top:.9rem;left:.9rem;background:var(--gold);color:var(--ink);font-size:.53rem;letter-spacing:.15em;text-transform:uppercase;padding:.22rem .6rem;border-radius:1px;font-weight:500;z-index:3}
.p-body{padding:1.5rem 1.5rem 1.8rem}
.p-cat{font-size:.56rem;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);margin-bottom:.45rem;display:block}
.p-name{font-family:'Cormorant Garamond',serif;font-size:1.45rem;font-weight:400;color:var(--cream);margin-bottom:.45rem;line-height:1.2}
.p-desc{font-size:.77rem;color:var(--muted);line-height:1.7;margin-bottom:1.1rem}
.p-price{font-family:'Cormorant Garamond',serif;font-size:1.25rem;color:var(--cream);margin-bottom:1rem}
.p-price s{font-size:.85rem;color:var(--muted);margin-right:.4rem;font-family:'DM Sans',sans-serif}
.p-price .disc{background:rgba(200,152,64,.14);color:var(--gold);font-size:.58rem;padding:.15rem .45rem;border-radius:1px;font-family:'DM Sans',sans-serif;letter-spacing:.08em;vertical-align:middle}
.p-cta{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--gold);border:none;border-bottom:1px solid rgba(200,152,64,.3);background:none;padding-bottom:3px;cursor:pointer;transition:color .25s,border-color .25s,letter-spacing .25s;font-family:'DM Sans',sans-serif}
.p-cta:hover{color:var(--gold-hi);border-color:var(--gold-hi);letter-spacing:.28em}

/* ── FEATURED SHOWROOM GALLERY ── */
#gallery{background:var(--deep);padding:80px 5%}
.gallery-grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:300px 300px;gap:4px}
.g-cell{overflow:hidden;position:relative}
.g-cell img{width:100%;height:100%;object-fit:cover;transition:transform .6s ease;filter:sepia(.08) contrast(1.05)}
.g-cell:hover img{transform:scale(1.06)}
.g-cell:first-child{grid-row:span 2}
.g-label{position:absolute;bottom:.8rem;left:.8rem;background:rgba(8,6,10,.78);backdrop-filter:blur(8px);border:1px solid rgba(200,152,64,.18);color:var(--gold);font-size:.54rem;letter-spacing:.18em;text-transform:uppercase;padding:.3rem .7rem;border-radius:1px;z-index:2}

/* ── DESIGNERS ── */
#designers{background:var(--deep);position:relative;overflow:hidden}
#designers::after{content:'';position:absolute;right:-100px;bottom:-100px;width:400px;height:400px;border-radius:50%;background:radial-gradient(circle,rgba(200,152,64,.05),transparent 65%)}
.designers-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:1rem}
.d-card{background:rgba(255,255,255,.022);border:1px solid rgba(200,152,64,.1);border-radius:2px;padding:2.2rem 2rem;position:relative;overflow:hidden;transition:border-color .35s,transform .35s}
.d-card:hover{border-color:rgba(200,152,64,.25);transform:translateY(-4px)}
.d-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:0;transition:opacity .35s}
.d-card:hover::before{opacity:1}
.d-avatar{width:58px;height:58px;border-radius:50%;background:linear-gradient(135deg,var(--wood-mid),var(--wood-deep));border:1px solid rgba(200,152,64,.3);display:flex;align-items:center;justify-content:center;margin-bottom:1.2rem;font-family:'Cormorant Garamond',serif;font-size:1.5rem;color:var(--gold);font-weight:600}
